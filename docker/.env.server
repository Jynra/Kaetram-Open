# Default env for server container
NAME='Kaetram'

# Bind to all interfaces inside container
HOST='0.0.0.0'
PORT=3173

# Disable SSL for local container
SSL=false

# No hub by default
HUB_ENABLED=false

# Database (can be overridden). For quick start without DB:
SKIP_DATABASE=true
DATABASE='mongodb'
MONGODB_HOST='mongodb'
MONGODB_PORT=27017
MONGODB_DATABASE='kaetram_container'
MONGODB_SRV=false
MONGODB_TLS=false

# Licensing (required by app)
ACCEPT_LICENSE=true

