# Default env for client build
# The client embeds these at build time via @kaetram/common/config

NAME='Kaetram'

# Where the client connects for WS by default
HOST='localhost'
PORT=3173
SSL=false

# If you want to use hub, set HUB_ENABLED=true and adjust HUB_HOST/PORT
HUB_ENABLED=false
HUB_HOST='localhost'
HUB_PORT=9526

# Expose client on different HTTP port (nginx, not used by app config)
# We serve on 3174 externally via nginx

# Client can run without DB, but license must be accepted
ACCEPT_LICENSE=true

